{
	"name": "@nuru/wasm",
	"version": "0.5.19",
	"description": "A wasm intepreter for [Nuru](https://github.com/NuruProgramming/Nuru)",
	"main": "dist/index.js",
	"files": [
		"dist",
		"main.wasm",
		"wasm_exec_tinygo.js",
		"wasm_exec_go.js"
	],
	"scripts": {
		"update-core": "git submodule update --remote deps/nuru",
		"test": "echo \"Mocktest Wasm-core  🟢 🟢 🟢 🟢\" && exit 0 >> /dev/null",
		"build:wasm": "cd core/Nuru && GOOS=js GOARCH=wasm tinygo build -o ../../main.wasm",
		"build": "tsc",
		"dev:wasm": "air",
		"dev:ts": "tsc --watch",
		"dev:serve":"node scripts/serve.js",
		"dev":"turbo run dev:wasm dev:ts dev:serve",
		"prepublishOnly": "pnpm run build:wasm && pnpm run build"
	},
	"type": "module",
	"man": "./dist/index.js",
	"imports": {
		"#wasm_exec":{
			"development":"./wasm_exec_go.js",
			"default":"./wasm_exec_tinygo.js"
		}
	},
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./react": {
			"default": "./dist/react/index.js",
			"types": "./dist/react/index.d.ts"
		}
	},
	"keywords": [],
	"author": "Nehemia Kaaya <heracraft@teksafari.org>",
	"license": "ISC",
	"dependencies": {
		"@types/golang-wasm-exec": "^1.15.2",
		"xss": "^1.0.15"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"react": "^19",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^16.8.0"
	}
}
