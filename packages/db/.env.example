# Local development: set ONLY this. It's the password for the Docker Postgres
# (docker-compose.yml) and is used to build the local connection string
# postgres://postgres:<password>@localhost:5432/postgres.
DEV_POSTGRES_PASSWORD=..............

# Remote/prod (Neon) ONLY. Leave this UNSET for local development.
# When set to a Neon string (contains "neondb_owner"), the app and drizzle-kit
# will target the remote database instead of the local container.
# DATABASE_URL=postgres://neondb_owner....