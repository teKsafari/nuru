{
	"name": "nuru-wasm-monorepo",
	"private": true,
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "turbo run build",
		"predev":"portless proxy start --no-tls --port 3941",
		"dev": "turbo run dev",
		"clean": "portless proxy stop",
		"start": "turbo run start",
		"test": "turbo run test --output-logs=new-only",
		"lint": "turbo run lint",
		"format": "turbo run format"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": "22"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm"
		}
	},
	"devDependencies": {
		"turbo": "^2.7.1"
	}
}
