{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalDependencies": [".env"],
	"globalEnv": ["DATABASE_URL", "LOGTO_APP_ID", "LOGTO_BASE_URL", "LOGTO_APP_SECRET", "DB_URL"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", "public/build/**", "main.wasm", "main"]
		},
		"nuru-playground#build": {
			"dependsOn": ["@nuru/wasm#build"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"dev:wasm": {
			"persistent": true,
			"cache": false
		},
		"dev:ts": {
			"persistent": true,
			"cache": false
		},
		"dev:serve": {
			"persistent": true,
			"cache": false
		},
		"test": {
			"dependsOn": ["^test"],
			"cache": false
		},
		"start": {
			"persistent": true,
			"cache": false
		},
		"lint": {
			"outputs": []
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:push": {
			"cache": false
		},
		"db:studio": {
			"cache": false
		}
	}
}
