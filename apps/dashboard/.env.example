LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=http://localhost:3001
DATABASE_URL=

# Local development only. Logto cannot redirect to a dev machine, so with
# NURU_DEV_AUTH=1 (and NODE_ENV != production) the dashboard treats you as a fake
# signed-in teacher, "Mwalimu Dev" (sub dev-mwalimu, roles Super Admin + Educator).
# NURU_DEV_AUTH=1

# Where learners open the playground; shown on the class projector screen.
# NEXT_PUBLIC_PLAYGROUND_URL=https://nuruprogramming.org
